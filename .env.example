# ===== LLM（OpenAI 兼容接口，支持 DeepSeek / 智谱 GLM / Qwen 等）=====
# DeepSeek 示例
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 智谱示例：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 可选搜索源（L1 兜底切换链，不填则仅用 DuckDuckGo）=====
TAVILY_API_KEY=
BOCHA_API_KEY=

# ===== 演示/测试开关（1=不调用真实 LLM/搜索，使用内置 Mock，可离线跑通全流程）=====
MOCK_LLM=0
MOCK_SEARCH=0

# ===== 服务（可选）=====
# AUTH_TOKEN=change-me        # 非空则启用 API 令牌鉴权（页面设置中填入同一令牌），建议 ≥8 位
# ALLOW_ORIGINS=*             # CORS 允许来源，逗号分隔；生产请显式指定
# LOG_LEVEL=INFO
# DATA_DIR=./data             # SQLite 数据目录（Docker 挂卷用）
# EXPOSE_DOCS=0               # 1 = 开放 /docs、/redoc、/openapi.json（生产不建议）
# TRUST_PROXY=0               # 1 = 位于 Nginx 等可信反代之后，按 X-Forwarded-For 识别客户端 IP
                              #     直连部署请保持 0，否则限流可被伪造头绕过
